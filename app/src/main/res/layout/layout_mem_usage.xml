<!-- Must stay a single view: SwipeRevealLayout asserts childCount == 2 and indexes its children positionally, so this include
	is its hidden content and cannot gain a sibling. -->
<com.itsaky.androidide.ui.MetricsCarouselLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="@dimen/editor_mem_usage_view_height">

	<androidx.viewpager2.widget.ViewPager2
		android:id="@+id/metrics_pager"
		android:layout_width="0dp"
		android:layout_height="0dp"
		app:layout_constraintBottom_toTopOf="@id/metrics_indicator"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent" />

	<com.google.android.material.tabs.TabLayout
		android:id="@+id/metrics_indicator"
		android:layout_width="wrap_content"
		android:layout_height="@dimen/metrics_carousel_indicator_height"
		android:background="@android:color/transparent"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:tabBackground="@drawable/metrics_carousel_dot"
		app:tabGravity="center"
		app:tabIndicatorHeight="0dp"
		app:tabPaddingEnd="@dimen/metrics_carousel_dot_spacing"
		app:tabPaddingStart="@dimen/metrics_carousel_dot_spacing" />

</com.itsaky.androidide.ui.MetricsCarouselLayout>
