<!-- Must stay a single view: SwipeRevealLayout asserts childCount == 2 and indexes its children positionally, so this include
	is its hidden content and cannot gain a sibling. -->
<com.itsaky.androidide.ui.MetricsCarouselLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="@dimen/editor_mem_usage_view_height">

	<!-- The pager takes whatever height the title leaves, so the title can grow with the font scale without being clipped
		and without the panel changing height. -->
	<androidx.viewpager2.widget.ViewPager2
		android:id="@+id/metrics_pager"
		android:layout_width="0dp"
		android:layout_height="0dp"
		app:layout_constraintBottom_toTopOf="@id/metrics_title"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent" />

	<TextView
		android:id="@+id/metrics_title"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:gravity="center"
		android:paddingHorizontal="@dimen/metrics_carousel_title_padding_horizontal"
		android:paddingVertical="@dimen/metrics_carousel_title_padding_vertical"
		android:textAppearance="?attr/textAppearanceLabelMedium"
		android:textColor="?attr/colorOnSurface"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		tools:text="Memory usage"
		xmlns:tools="http://schemas.android.com/tools" />

	<!-- Shown in place of the carousel while it is floating in its own window. Only one carousel can be live at a time (the
		watchers hold a single listener each), so undocking moves it out of the editor rather than copying it; without this the reveal
		would open on an empty strip that reads as broken, and there would be no way back if the window is off screen. -->
	<TextView
		android:id="@+id/metrics_undocked_message"
		android:layout_width="0dp"
		android:layout_height="0dp"
		android:background="?attr/selectableItemBackground"
		android:clickable="true"
		android:focusable="true"
		android:gravity="center"
		android:padding="@dimen/metrics_carousel_title_padding_horizontal"
		android:text="@string/metrics_carousel_undocked"
		android:textAppearance="?attr/textAppearanceLabelMedium"
		android:textColor="?attr/colorOnSurface"
		android:visibility="gone"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent" />

</com.itsaky.androidide.ui.MetricsCarouselLayout>
