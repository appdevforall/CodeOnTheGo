From 0432e1e8dac47a8e54b2f4b812fabe20ea9e8be3 Mon Sep 17 00:00:00 2001
From: David Schachter <davidschachter@appdevforall.org>
Date: Fri, 13 Nov 2026 16:58:23 -0800
Subject: [PATCH] End a cancelled call's result sets as interrupted, and stop
 their finals

Since 1.4.2 every result set still open when the outermost call into
JavaScript returns is ended there, which runs the final of each window
or aggregate function its statement was computing. Each final enters
JavaScript as a new outermost call, so js_enter() took the cancel epoch
of that moment and a cancel during the call no longer stopped it. On
SQLite 3.41 and later the interrupt the cancel left on the connection
does; before 3.41 nothing did, and a final that never ends hung the
statement for good.

The finals that ending a call's result sets runs now keep that call's
epoch. A cancel during the call, or during the ending, stops every one
of them, and a cancel that lands just before the call returns fails the
statement with an interrupt, rather than letting the call succeed with
its finals skipped. Reading on from those result sets throws
"interrupted", as after sqlite3_interrupt() on 3.41 and later, rather
than the message for a result set that outlived its call.

Before 3.41, an sqlite3_interrupt() that no cancel came with still reads
as the result set outliving its call: nothing shows it.
---
 src/sqlitejs.c | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/src/sqlitejs.c b/src/sqlitejs.c
index e5fea55..29499a0 100644
--- a/src/sqlitejs.c
+++ b/src/sqlitejs.c
@@ -576,7 +576,10 @@ static bool js_stack_room (size_t *room) {
 // runs JavaScript) is on the same thread and keeps the outer call's limit.
 static void js_enter (globaljs_context *js) {
     if (js->depth++ > 0) return;
-    js->cancel_epoch = js_cancel_epoch_load();
+    // The finals that ending a call's result sets runs (see js_leave) belong to that call: they keep
+    // its epoch, so a cancel during the call or during the ending stops them, as it would have
+    // stopped the call. Before SQLite 3.41 nothing else would stop one that never ends.
+    if (!js->ending_rowsets) js->cancel_epoch = js_cancel_epoch_load();
     JS_UpdateStackTop(js->runtime);
     // A thread with less room than SQLITE_JS_STACK_MIN keeps it too: JavaScript there then fails
     // with "Maximum call stack size exceeded" rather than running past the end of the stack. A
@@ -591,7 +594,10 @@ static void js_enter (globaljs_context *js) {
 static void js_leave (globaljs_context *js) {
     if (--js->depth > 0) return;
     if (!js->rowsets) return;
-    bool interrupted = (sqlite3_libversion_number() >= 3041000) && js->db && sqlite3_is_interrupted(js->db);
+    // A cancel (sqlitejs_cancel_all) during the call interrupted it, and before SQLite 3.41 is
+    // the only interrupt that shows: its result sets read on as interrupted.
+    bool cancelled = (js->cancel_epoch != js_cancel_epoch_load());
+    bool interrupted = cancelled || ((sqlite3_libversion_number() >= 3041000) && js->db && sqlite3_is_interrupted(js->db));
     js_end_rowsets(js, true, interrupted);
 }
 
