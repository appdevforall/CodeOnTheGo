From 09aa66a1ed410a588afb8233ecc574d908087231 Mon Sep 17 00:00:00 2001
From: David Schachter <davidschachter@appdevforall.org>
Date: Sun, 15 Nov 2026 22:10:52 -0800
Subject: [PATCH] End a cancelled call's result sets as interrupted, and stop
 their finals

Since 1.4.2 every result set still open when the outermost call into
JavaScript returns is ended there, which runs the final of each window
or aggregate function its statement was computing. Each final enters
JavaScript as a new outermost call, so js_enter() took the cancel epoch
of that moment and a cancel during the call no longer stopped it. On
SQLite 3.41 and later the interrupt the cancel left on the connection
does; before 3.41 nothing did, and a final that never ends hung the
statement for good.

The finals that ending a call's result sets runs now keep that call's
epoch, so a cancel during the call, or during the ending, stops each of
them at QuickJS's next interrupt check: one that never ends is stopped
and the statement fails with an interrupt, though a short final can
still run to its end. Reading on from those result sets throws
"interrupted", as after sqlite3_interrupt() on 3.41 and later, rather
than the message for a result set that outlived its call, whether the
cancel came before the call returned or while its result sets were
ended. js_end_rowsets() marks both after its loop, by the pass that
ended them, since a final it runs can free result sets of the list;
js_leave() no longer needs to mark a cancelled call's result sets
itself.

Before 3.41, an sqlite3_interrupt() that no cancel came with still reads
as the result set outliving its call: nothing shows it.

The comment at the interrupt handler now says that only the JavaScript
the extension runs while it initialises a connection is exempt from a
cancel, not stored functions loaded by js_init_table. A rowset's
end_pass is initialised where it is created, and sqlitejs_cancel_all is
documented in sqlitejs.h.
---
 src/sqlitejs.c | 26 +++++++++++++++++++++++---
 src/sqlitejs.h |  2 ++
 2 files changed, 25 insertions(+), 3 deletions(-)

diff --git a/src/sqlitejs.c b/src/sqlitejs.c
index e5fea55..0a32d36 100644
--- a/src/sqlitejs.c
+++ b/src/sqlitejs.c
@@ -75,6 +75,7 @@ typedef struct {
     struct rowset       *rowsets;       // result sets not yet freed: see js_end_rowsets()
     int                 orphans;        // of those, the ones whose JavaScript object is gone
     bool                ending_rowsets; // js_end_rowsets() is running
+    unsigned            end_pass;       // js_end_rowsets() passes that ended every result set
 } globaljs_context;
 
 typedef struct {
@@ -117,6 +118,7 @@ typedef struct rowset {
     bool            ended;          // ended by js_end_rowsets(): reading on throws
     bool            interrupted;    // and an interrupt is why: reading on throws "interrupted"
     bool            orphaned;       // its JavaScript object is gone: see js_rowset_finalizer()
+    unsigned        end_pass;       // the js_end_rowsets() pass that ended it
     struct rowset   *prev, *next;   // in the connection's list: see js_end_rowsets()
 } rowset;
 
@@ -272,9 +274,12 @@ static void js_rowset_finalizer(JSRuntime *rt, JSValue val) {
 // computing, whose js_leave() comes back here and whose garbage collection can free result sets
 // of the list. So each statement is taken from its result set before it is finalized, the list
 // is walked again from its head after each one, and a nested call does nothing.
+static unsigned js_cancel_epoch_load (void);
+
 static void js_end_rowsets (globaljs_context *js, bool all, bool interrupted) {
     if (js->ending_rowsets) return;
     js->ending_rowsets = true;
+    unsigned pass = all ? ++js->end_pass : 0;
     for (;;) {
         rowset *rs = js->rowsets;
         while (rs && !(rs->orphaned || (all && rs->vm))) rs = rs->next;
@@ -291,10 +296,17 @@ static void js_end_rowsets (globaljs_context *js, bool all, bool interrupted) {
         } else {
             rs->vm = NULL;
             rs->ended = true;
+            rs->end_pass = pass;
             if (interrupted) rs->interrupted = true;
         }
         if (vm) sqlite3_finalize(vm);
     }
+    // A cancel that landed while the finals ran stopped them, as one before the call returned
+    // would have: the result sets this pass ended read on as interrupted too. Nothing runs
+    // JavaScript here, so the list holds only result sets that are still allocated.
+    if (all && !interrupted && (js->cancel_epoch != js_cancel_epoch_load())) {
+        for (rowset *r = js->rowsets; r; r = r->next) if (r->ended && (r->end_pass == pass)) r->interrupted = true;
+    }
     js->ending_rowsets = false;
 }
 
@@ -358,8 +370,10 @@ static int js_interrupt_handler (JSRuntime *rt, void *opaque) {
     UNUSED(rt);
     globaljs_context *js = (globaljs_context *)opaque;
     js_keep_gc_below_limit(js);
-    // Only a call (see js_enter) is cancelled: the JavaScript a connection runs while it is set
-    // up is not one, and stopping it would make the connection fail to load the extension.
+    // Only a call (see js_enter) is cancelled. The one exception is the JavaScript the extension
+    // itself runs while it initialises a connection (globaljs_init, depth 0): stopping it would
+    // make the connection fail to load. Stored functions loaded by js_init_table run as a call,
+    // so they can be cancelled.
     if ((js->depth > 0) && (js->cancel_epoch != js_cancel_epoch_load())) {
         // The statement is interrupted too: a collation cannot report an error, so the
         // statement would go on calling JavaScript, each call beginning after the cancel.
@@ -576,7 +590,10 @@ static bool js_stack_room (size_t *room) {
 // runs JavaScript) is on the same thread and keeps the outer call's limit.
 static void js_enter (globaljs_context *js) {
     if (js->depth++ > 0) return;
-    js->cancel_epoch = js_cancel_epoch_load();
+    // The finals that ending a call's result sets runs (see js_leave) belong to that call: they keep
+    // its epoch, so a cancel during the call or during the ending stops them, as it would have
+    // stopped the call. Before SQLite 3.41 nothing else would stop one that never ends.
+    if (!js->ending_rowsets) js->cancel_epoch = js_cancel_epoch_load();
     JS_UpdateStackTop(js->runtime);
     // A thread with less room than SQLITE_JS_STACK_MIN keeps it too: JavaScript there then fails
     // with "Maximum call stack size exceeded" rather than running past the end of the stack. A
@@ -591,6 +608,8 @@ static void js_enter (globaljs_context *js) {
 static void js_leave (globaljs_context *js) {
     if (--js->depth > 0) return;
     if (!js->rowsets) return;
+    // A cancel (sqlitejs_cancel_all) is not seen here: js_end_rowsets() marks its result sets
+    // interrupted itself, which is the only way they read so before SQLite 3.41.
     bool interrupted = (sqlite3_libversion_number() >= 3041000) && js->db && sqlite3_is_interrupted(js->db);
     js_end_rowsets(js, true, interrupted);
 }
@@ -936,6 +955,7 @@ static JSValue js_sqlite_exec (JSContext *ctx, sqlite3 *db, const char *sql, int
     rs->vm = vm;
     rs->ncols = sqlite3_column_count(vm);
     rs->ended = false;
+    rs->end_pass = 0;
     rs->interrupted = false;
     rs->orphaned = false;
     rs->prev = rs->next = NULL;
diff --git a/src/sqlitejs.h b/src/sqlitejs.h
index ed6ce4e..7cf1ce3 100644
--- a/src/sqlitejs.h
+++ b/src/sqlitejs.h
@@ -21,6 +21,8 @@
 int sqlite3_js_init (sqlite3 *db, char **pzErrMsg, const sqlite3_api_routines *pApi);
 const char *sqlitejs_version (void);
 const char *quickjs_version (void);
+// Stops all JavaScript now running, in every connection. Safe to call from any thread. It
+// stops only JavaScript already running: calls that begin afterwards are not affected.
 void sqlitejs_cancel_all (void);
 
 #endif
-- 
2.53.0

