From d1a8930a6c095a54df562ab7ec395975c99777f1 Mon Sep 17 00:00:00 2001
From: David Schachter <davidschachter@appdevforall.org>
Date: Tue, 10 Nov 2026 21:16:06 -0800
Subject: [PATCH 06/10] Report exceptions thrown by aggregate and window steps

js_execute_common() turned the result of a function into an SQL result
only when the caller wanted the value. The step function of an aggregate
or window function, and the inverse function of a window function,
return nothing, so their result was dropped, and with it any exception
they threw: the aggregate went on as if the row had been added or
removed. A step that threw, or ran out of memory, gave a wrong result
with no error.

Report an exception thrown by a step or inverse function as an SQL error.
Reported from xStep or xInverse, it makes SQLite abort the statement,
which still calls xFinal, so the aggregate context is released as before.

Add an Aggregate errors test: an exception in an aggregate step and in a
window inverse function each fail the statement with its message, and the
connection stays usable.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Vh2DAXGyHbMzjSsi2zbrkw
---
 src/sqlitejs.c |  3 +++
 test/main.c    | 33 +++++++++++++++++++++++++++++++++
 2 files changed, 36 insertions(+)

diff --git a/src/sqlitejs.c b/src/sqlitejs.c
index 2802421..d29ec40 100644
--- a/src/sqlitejs.c
+++ b/src/sqlitejs.c
@@ -1027,6 +1027,9 @@ static void js_execute_common (sqlite3_context *context, JSContext *js_context,
     JS_FreeValue(js_context, args);
     
     if (return_value) js_value_to_sqlite(context, js_context, result);
+    // step and inverse functions return nothing, but an exception they throw is still an error:
+    // reported from xStep or xInverse, it makes SQLite abort the statement
+    else if (JS_IsException(result)) js_error_to_sqlite(context, js_context, result, NULL);
     JS_FreeValue(js_context, result);
 }
 
diff --git a/test/main.c b/test/main.c
index 2c66aa7..20e34a0 100644
--- a/test/main.c
+++ b/test/main.c
@@ -821,6 +821,38 @@ abort_test:
     return rc;
 }
 
+// MARK: - Aggregate errors -
+
+int test_aggregate_errors (void) {
+    sqlite3 *db = NULL;
+    int rc = test_open(&db);
+    if (rc != SQLITE_OK) goto abort_test;
+
+    rc = db_exec(db, "CREATE TABLE t (x); INSERT INTO t VALUES (1), (2), (3);");
+    if (rc != SQLITE_OK) goto abort_test;
+
+    // an exception thrown by an aggregate's step function fails the statement
+    rc = db_exec(db, "SELECT js_create_aggregate('step_fails', 'n = 0;', '(function(args){ if (args[0] == 2) throw new Error(\"step boom\"); n++; })', '(function(){ return n; })');");
+    if (rc != SQLITE_OK) goto abort_test;
+    rc = check_error(db, "SELECT step_fails(x) FROM t;", "step boom");
+    if (rc != SQLITE_OK) goto abort_test;
+
+    // so does one thrown by a window function's inverse function
+    rc = db_exec(db, "SELECT js_create_window('inverse_fails', 'total = 0;', '(function(args){ total += args[0]; })', '(function(){ return total; })', '(function(){ return total; })', '(function(args){ throw new Error(\"inverse boom\"); })');");
+    if (rc != SQLITE_OK) goto abort_test;
+    rc = check_error(db, "SELECT inverse_fails(x) OVER (ORDER BY x ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) FROM t;", "inverse boom");
+    if (rc != SQLITE_OK) goto abort_test;
+
+    // and the connection stays usable
+    rc = check_query(db, "SELECT js_eval('[1, 2, 3].join()');", "1,2,3");
+    if (rc != SQLITE_OK) goto abort_test;
+
+abort_test:
+    if (rc != SQLITE_OK && db) printf("Error: %s\n", sqlite3_errmsg(db));
+    if (db) sqlite3_close(db);
+    return rc;
+}
+
 // MARK: -
 
 int test_report(const char *description, int rc){
@@ -842,6 +874,7 @@ int main (void) {
     result += test_report("Direct only", test_direct_only());
     result += test_report("Blobs", test_blobs());
     result += test_report("Numbers", test_numbers());
+    result += test_report("Aggregate errors", test_aggregate_errors());
 
     sqlite3_int64 current = 0;
     sqlite3_int64 highwater = 0;
