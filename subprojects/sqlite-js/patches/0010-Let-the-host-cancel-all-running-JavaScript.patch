From ef4e501a7a691d38fbd1ca46454d921d1e30cd9f Mon Sep 17 00:00:00 2001
From: David Schachter <davidschachter@appdevforall.org>
Date: Wed, 11 Nov 2026 16:43:39 -0800
Subject: [PATCH 10/10] Let the host cancel all running JavaScript

sqlitejs_cancel_all() stops the JavaScript running in every connection:
each call fails with an "interrupted" error, even code that catches
every exception. JavaScript that begins afterwards runs normally.

Android cannot otherwise stop a runaway function: it cancels a query
with a progress handler, which SQLite never calls while a function runs,
and Room 2.7 and later pass no cancellation signal at all. A global
epoch, read when the outermost call into JavaScript begins and compared
by the existing interrupt handler, makes the cancel reach every runtime
without a list of connections. The interrupt handler is now installed
even when sqlite3_is_interrupted() is unavailable (SQLite before 3.41),
so cancelling still works there.
---
 src/sqlitejs.c | 36 +++++++++++++++++++++++++++++++++---
 src/sqlitejs.h |  1 +
 test/main.c    | 46 ++++++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 80 insertions(+), 3 deletions(-)

diff --git a/src/sqlitejs.c b/src/sqlitejs.c
index 5abf713..e853b0e 100644
--- a/src/sqlitejs.c
+++ b/src/sqlitejs.c
@@ -55,6 +55,8 @@ typedef struct {
     size_t              memory_limit;   // in bytes, 0 for none: see js_set_memory_limit()
     size_t              stack_size;     // in bytes, 0 for no check: see js_set_max_stack_size()
     int                 depth;          // calls into JavaScript in progress: see js_enter()
+    unsigned            cancel_epoch;   // js_cancel_epoch when the outermost call began
+    bool                check_interrupted;  // sqlite3_is_interrupted() is available
 } globaljs_context;
 
 typedef struct {
@@ -237,6 +239,29 @@ static void js_rowset_finalizer(JSRuntime *rt, JSValue val) {
 #define SQLITE_JS_STACK_MARGIN  (256 * 1024)
 #endif
 
+// Bumped by sqlitejs_cancel_all(): JavaScript that began before stops, as if interrupted.
+static unsigned js_cancel_epoch;
+
+static unsigned js_cancel_epoch_load (void) {
+#if defined(__clang__) || defined(__GNUC__)
+    return __atomic_load_n(&js_cancel_epoch, __ATOMIC_ACQUIRE);
+#else
+    return *(volatile unsigned *)&js_cancel_epoch;
+#endif
+}
+
+// Stops all JavaScript that is running now, in every connection: each call fails with an
+// "interrupted" error. JavaScript that begins afterwards runs normally. Safe from any thread.
+// For hosts whose own cancelling cannot reach JavaScript: Android cancels a query with a
+// progress handler, which SQLite never calls while a JavaScript function runs.
+void sqlitejs_cancel_all (void) {
+#if defined(__clang__) || defined(__GNUC__)
+    __atomic_add_fetch(&js_cancel_epoch, 1, __ATOMIC_RELEASE);
+#else
+    (*(volatile unsigned *)&js_cancel_epoch)++;
+#endif
+}
+
 // The lowest address of the calling thread's stack, found once per thread: on Linux, finding the
 // main thread's stack reads /proc/self/maps. Returns false where the stack cannot be found.
 static bool js_stack_low (uintptr_t sp, uintptr_t *low) {
@@ -302,6 +327,7 @@ static bool js_stack_room (size_t *room) {
 // runs JavaScript) is on the same thread and keeps the outer call's limit.
 static void js_enter (globaljs_context *js) {
     if (js->depth++ > 0) return;
+    js->cancel_epoch = js_cancel_epoch_load();
     JS_UpdateStackTop(js->runtime);
     size_t size = js->stack_size, room = 0;
     if ((size > 0) && js_stack_room(&room) && (room < size)) size = (room > 0) ? room : 1;
@@ -318,7 +344,8 @@ static void js_leave (globaljs_context *js) {
 static int js_interrupt_handler (JSRuntime *rt, void *opaque) {
     UNUSED(rt);
     globaljs_context *js = (globaljs_context *)opaque;
-    return (js->db != NULL) && sqlite3_is_interrupted(js->db);
+    if (js->cancel_epoch != js_cancel_epoch_load()) return 1;
+    return js->check_interrupted && (js->db != NULL) && sqlite3_is_interrupted(js->db);
 }
 
 static globaljs_context *globaljs_init (sqlite3 *db) {
@@ -328,6 +355,8 @@ static globaljs_context *globaljs_init (sqlite3 *db) {
     globaljs_context *js = (globaljs_context *)sqlite3_malloc(sizeof(globaljs_context));
     if (!js) return NULL;
     memset(js, 0, sizeof(globaljs_context));
+    // JavaScript that runs while the connection is set up must not count as begun before a cancel
+    js->cancel_epoch = js_cancel_epoch_load();
     
     rt = JS_NewRuntime();
     if (!rt) goto abort_init;
@@ -336,8 +365,9 @@ static globaljs_context *globaljs_init (sqlite3 *db) {
     //JS_SetMaxStackSize(rt, 10 * 1024);
 
     // sqlite3_is_interrupted() is new in SQLite 3.41.0: an older library has no such entry
-    // in its sqlite3_api_routines, so JavaScript cannot be interrupted there
-    if (sqlite3_libversion_number() >= 3041000) JS_SetInterruptHandler(rt, js_interrupt_handler, js);
+    // in its sqlite3_api_routines, so JavaScript cannot be interrupted there, only cancelled
+    js->check_interrupted = (sqlite3_libversion_number() >= 3041000);
+    JS_SetInterruptHandler(rt, js_interrupt_handler, js);
 
     // the default stack size must fit in the stack of the thread that loads the extension: Windows
     // gives a main thread 1 MB, and apps often give their threads no more
diff --git a/src/sqlitejs.h b/src/sqlitejs.h
index 80fe49d..fea0870 100644
--- a/src/sqlitejs.h
+++ b/src/sqlitejs.h
@@ -21,5 +21,6 @@
 int sqlite3_js_init (sqlite3 *db, char **pzErrMsg, const sqlite3_api_routines *pApi);
 const char *sqlitejs_version (void);
 const char *quickjs_version (void);
+void sqlitejs_cancel_all (void);
 
 #endif
diff --git a/test/main.c b/test/main.c
index 53f77de..49ac377 100644
--- a/test/main.c
+++ b/test/main.c
@@ -648,6 +648,51 @@ abort_test:
     return rc;
 }
 
+// MARK: - Cancel all -
+
+static void *test_cancel_all_worker (void *ptr) {
+    (void)ptr;
+    // give the statement time to start running JavaScript
+    usleep(200 * 1000);
+    sqlitejs_cancel_all();
+    return NULL;
+}
+
+// sqlitejs_cancel_all() stops the JavaScript running in every connection, as Android's own
+// cancelling (a progress handler, which SQLite never calls while a function runs) cannot.
+int test_cancel_all (void) {
+    sqlite3 *db = NULL, *db2 = NULL;
+    pthread_t thread;
+
+    // if the code cannot be cancelled, end the test program instead of hanging forever
+    alarm(30);
+
+    int rc = test_open(&db);
+    if (rc != SQLITE_OK) goto abort_test;
+    rc = db_exec(db, "SELECT js_create_scalar('spin', '(function (args) { for (;;) { try { while (true) {} } catch (e) {} } })');");
+    if (rc != SQLITE_OK) goto abort_test;
+
+    // JavaScript running now stops, even code that catches every exception
+    if (pthread_create(&thread, NULL, test_cancel_all_worker, NULL) != 0) { rc = SQLITE_ERROR; goto abort_test; }
+    rc = check_error(db, "SELECT spin();", "interrupted");
+    pthread_join(thread, NULL);
+    if (rc != SQLITE_OK) goto abort_test;
+
+    // JavaScript that begins afterwards runs normally, on this connection and on a new one
+    rc = check_query(db, "SELECT js_eval('1 + 1');", "2");
+    if (rc != SQLITE_OK) goto abort_test;
+    rc = test_open(&db2);
+    if (rc != SQLITE_OK) goto abort_test;
+    rc = check_query(db2, "SELECT js_eval('2 + 2');", "4");
+
+abort_test:
+    alarm(0);
+    if (rc != SQLITE_OK && db) printf("Error: %s\n", sqlite3_errmsg(db));
+    if (db) sqlite3_close(db);
+    if (db2) sqlite3_close(db2);
+    return rc;
+}
+
 // MARK: - Stack size -
 
 int test_stack_size (void) {
@@ -1014,6 +1059,7 @@ int main (void) {
     result += test_report("Serialization 3", test_serialization(DB_PATH, true,  3)); // load the new implementations
     result += test_report("Thread", test_thread());
     result += test_report("Interrupt", test_interrupt());
+    result += test_report("Cancel all", test_cancel_all());
     result += test_report("Memory limit", test_memory_limit());
     result += test_report("Stack size", test_stack_size());
     result += test_report("Stack on other threads", test_stack_threads());
