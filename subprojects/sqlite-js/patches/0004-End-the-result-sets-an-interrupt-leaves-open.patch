From 2744be532cb469b7d44b6cb86082760105fd25a9 Mon Sep 17 00:00:00 2001
From: David Schachter <davidschachter@appdevforall.org>
Date: Thu, 12 Nov 2026 16:07:37 -0800
Subject: [PATCH 4/4] End the result sets an interrupt leaves open

SQLite keeps an interrupt in effect until no statement of the connection
is running, and a db.exec result set that JavaScript leaves open is a
running statement. One kept in a global, or garbage not yet collected,
made every later statement on the connection fail with "interrupted",
the JavaScript that could release it included, until the connection
closed. In the sqlite3 shell, Ctrl-C during
  globalThis.held = db.exec("SELECT 1 UNION ALL SELECT 2"); held.next();
  while (true) {}
left the session unable to run anything.

Each connection now lists its result sets. When the outermost call into
JavaScript returns on an interrupted connection, no result set is being
stepped, so the open ones are finalized there; one that JavaScript kept
then throws "interrupted" from next() and toArray(). The interrupt then
clears as usual once the interrupted statement ends.

The Interrupt test now interrupts code that keeps a result set in a
global, and code whose result set is garbage, and checks that the
connection runs SQL afterwards and that the kept one throws. It fails
without this change.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Vh2DAXGyHbMzjSsi2zbrkw
---
 src/sqlitejs.c | 37 +++++++++++++++++++++++++++++++++----
 test/main.c    | 14 ++++++++++++++
 2 files changed, 47 insertions(+), 4 deletions(-)

diff --git a/src/sqlitejs.c b/src/sqlitejs.c
index 6c1183b..7f31883 100644
--- a/src/sqlitejs.c
+++ b/src/sqlitejs.c
@@ -72,6 +72,7 @@ typedef struct {
     int                 depth;          // calls into JavaScript in progress: see js_enter()
     unsigned            cancel_epoch;   // js_cancel_epoch when the outermost call began
     bool                check_interrupted;  // sqlite3_is_interrupted() is available
+    struct rowset       *rowsets;       // result sets not yet freed: see js_end_rowsets()
 } globaljs_context;
 
 typedef struct {
@@ -108,9 +109,11 @@ static JSValue sqlite_value_to_js (JSContext *ctx, sqlite3_value *value);
 
 // MARK: - RowSet -
 
-typedef struct {
+typedef struct rowset {
     int             ncols;
     sqlite3_stmt    *vm;
+    bool            interrupted;    // ended by js_end_rowsets(): reading on throws
+    struct rowset   *prev, *next;   // in the connection's list: see js_end_rowsets()
 } rowset;
 
 static void js_rowset_finalizer(JSRuntime *rt, JSValue val);
@@ -139,7 +142,7 @@ static JSValue js_rowset_next(JSContext *ctx, JSValueConst this_val, int argc, J
     rowset *rs = JS_GetOpaque(this_val, js->rowSetClassID);
     if (!rs) return JS_ThrowTypeError(ctx, "Not a Rowset object");
     
-    if (!rs->vm) return JS_FALSE;
+    if (!rs->vm) return rs->interrupted ? JS_ThrowInternalError(ctx, "interrupted") : JS_FALSE;
     int rc = sqlite3_step(rs->vm);
     if (rc == SQLITE_ROW) return JS_TRUE;
 
@@ -191,7 +194,7 @@ static JSValue js_rowset_to_array(JSContext *ctx, JSValueConst this_val, int arg
     globaljs_context *js = JS_GetContextOpaque(ctx);
     rowset *rs = JS_GetOpaque(this_val, js->rowSetClassID);
     if (!rs) return JS_ThrowTypeError(ctx, "Not a Rowset object");
-    if (!rs->vm) return JS_NewArray(ctx);
+    if (!rs->vm) return rs->interrupted ? JS_ThrowInternalError(ctx, "interrupted") : JS_NewArray(ctx);
 
     JSValue result = JS_NewArray(ctx);
     if (JS_IsException(result)) return JS_EXCEPTION;
@@ -233,10 +236,27 @@ static void js_rowset_finalizer(JSRuntime *rt, JSValue val) {
     rowset *rs = (rowset *)JS_GetOpaque(val, js->rowSetClassID);
     if (!rs) return;
     
+    if (rs->prev) rs->prev->next = rs->next;
+    else if (js->rowsets == rs) js->rowsets = rs->next;
+    if (rs->next) rs->next->prev = rs->prev;
     if (rs->vm) sqlite3_finalize(rs->vm);
     sqlite3_free(rs);
 }
 
+// Ends every result set of the connection that is still open. SQLite keeps an interrupt in effect
+// until no statement of the connection is running, and an open result set is a running statement:
+// one that JavaScript keeps, in a global say, or that is garbage not yet collected, would make every
+// later statement fail with "interrupted" until the connection closed, the statements that could
+// release it included. Only to be called where none of them is being stepped: see js_leave().
+static void js_end_rowsets (globaljs_context *js) {
+    for (rowset *rs = js->rowsets; rs; rs = rs->next) {
+        if (!rs->vm) continue;
+        sqlite3_finalize(rs->vm);
+        rs->vm = NULL;
+        rs->interrupted = true;
+    }
+}
+
 // MARK: - Initializer -
 
 // QuickJS collects cyclic garbage only when its memory use passes a threshold, which it resets
@@ -490,8 +510,11 @@ static void js_enter (globaljs_context *js) {
     JS_SetMaxStackSize(js->runtime, size);
 }
 
+// Once the outermost call has returned, no result set is being stepped, so those an interrupt left
+// open are ended here: see js_end_rowsets().
 static void js_leave (globaljs_context *js) {
-    js->depth--;
+    if (--js->depth > 0) return;
+    if ((sqlite3_libversion_number() >= 3041000) && js->db && sqlite3_is_interrupted(js->db)) js_end_rowsets(js);
 }
 
 static globaljs_context *globaljs_init (sqlite3 *db) {
@@ -827,12 +850,18 @@ static JSValue js_sqlite_exec (JSContext *ctx, sqlite3 *db, const char *sql, int
     if (!rs) goto abort_with_dberror;
     rs->vm = vm;
     rs->ncols = sqlite3_column_count(vm);
+    rs->interrupted = false;
+    rs->prev = rs->next = NULL;
     
     // create Rowset JS object
     globaljs_context *js = JS_GetContextOpaque(ctx);    
     JSValue obj = JS_NewObjectClass(ctx, js->rowSetClassID);
     if (JS_IsException(obj)) goto abort_with_jserror;
     JS_SetOpaque(obj, rs);
+    // listed once the object owns it, since its finalizer unlists it
+    rs->next = js->rowsets;
+    if (js->rowsets) js->rowsets->prev = rs;
+    js->rowsets = rs;
     JS_SetPropertyStr(ctx, obj, "columnCount", JS_NewInt32(ctx, rs->ncols));
     
     return obj;
diff --git a/test/main.c b/test/main.c
index dfb0079..63f9dab 100644
--- a/test/main.c
+++ b/test/main.c
@@ -577,6 +577,20 @@ int test_interrupt (void) {
     rc = test_interrupt_sql(db, "SELECT js_eval('for (;;) { try { while (true) {} } catch (e) {} }');");
     if (rc != SQLITE_OK) goto abort_test;
     
+    // A result set left open, kept in a global or garbage not yet collected, is a statement still
+    // running, and SQLite keeps an interrupt in effect until none is: every later statement on the
+    // connection failed. The interrupted call ends them, and the kept one then throws.
+    rc = test_interrupt_sql(db, "SELECT js_eval('globalThis.held = db.exec(\"SELECT 1 UNION ALL SELECT 2\"); held.next(); while (true) {}');");
+    if (rc != SQLITE_OK) goto abort_test;
+    rc = check_query(db, "SELECT 1 + 2;", "3");
+    if (rc != SQLITE_OK) goto abort_test;
+    rc = check_error(db, "SELECT js_eval('held.next()');", "interrupted");
+    if (rc != SQLITE_OK) goto abort_test;
+    rc = test_interrupt_sql(db, "SELECT js_eval('(function () { const r = db.exec(\"SELECT 1 UNION ALL SELECT 2\"); r.next(); while (true) {} })()');");
+    if (rc != SQLITE_OK) goto abort_test;
+    rc = check_query(db, "SELECT 1 + 2;", "3");
+    if (rc != SQLITE_OK) goto abort_test;
+    
 abort_test:
     test_watchdog_stop = 1;
     if (watching) pthread_join(watchdog, NULL);
-- 
