From d620ccae124cf2dfe3abc67865f300a65b2db0fd Mon Sep 17 00:00:00 2001
From: David Schachter <davidschachter@appdevforall.org>
Date: Tue, 10 Nov 2026 21:03:54 -0800
Subject: [PATCH 05/10] Return whole numbers as INTEGERs

QuickJS keeps the small whole numbers it can as 32-bit integers, and any
other number as a double, which went back to SQL as a REAL. So an INTEGER
outside the 32-bit range changed type on its way through a function:
`identity(2147483648)` returned 2147483648.0. The result of arithmetic
did too: js_eval('2 + 3') returned the INTEGER 5 but js_eval('2.5 * 2')
the REAL 5.0, and a JavaScript sum of large integers was a REAL.

Return a number that is a whole number from -(2^53 - 1) to 2^53 - 1
(Number.isSafeInteger), which a double holds exactly, as an INTEGER, and
any other number as a REAL, for function results and db.exec()
parameters alike. JavaScript cannot tell 3.0 from 3, so a REAL that holds
a whole number now comes back as an INTEGER; the README says so, and how
to pass an INTEGER beyond 2^53 - 1 without losing precision.

Add a Numbers test: integers in and beyond the 32-bit range round-trip
as INTEGERs, other REALs stay REAL, integers beyond 2^53 - 1 are REALs,
arithmetic results, an aggregate result past the 32-bit range, and
db.exec() parameters.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Vh2DAXGyHbMzjSsi2zbrkw
---
 README.md      |  4 +++-
 src/sqlitejs.c | 19 ++++++++++++++++++-
 test/main.c    | 43 +++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 64 insertions(+), 2 deletions(-)

diff --git a/README.md b/README.md
index 99abfb9..d2cf41b 100644
--- a/README.md
+++ b/README.md
@@ -187,7 +187,9 @@ SQL values reach JavaScript as follows:
 | TEXT | string |
 | BLOB | `ArrayBuffer` |
 
-A JavaScript result goes back to SQL as follows: `null` and `undefined` become NULL, a boolean an INTEGER (1 or 0), a number an INTEGER if it is a whole number in the 32-bit range and a REAL otherwise, a BigInt an INTEGER, a string TEXT, and an `ArrayBuffer` or a typed array such as `Uint8Array` a BLOB. Other objects become NULL; return `JSON.stringify(value)` to keep one as TEXT. The parameters of `db.exec()` convert the same way.
+A JavaScript result goes back to SQL as follows: `null` and `undefined` become NULL, a boolean an INTEGER (1 or 0), a number an INTEGER if it is a whole number from -(2^53 - 1) to 2^53 - 1 (`Number.isSafeInteger`) and a REAL otherwise, a BigInt an INTEGER, a string TEXT, and an `ArrayBuffer` or a typed array such as `Uint8Array` a BLOB. Other objects become NULL; return `JSON.stringify(value)` to keep one as TEXT. The parameters of `db.exec()` convert the same way.
+
+JavaScript has a single number type, a double. So a REAL that holds a whole number, such as 3.0, comes back as the INTEGER 3, and an INTEGER beyond ±(2^53 - 1) loses precision in JavaScript: pass it as TEXT, `CAST(x AS TEXT)`, and convert it with `BigInt(args[0])`.
 
 ## Scalar Functions
 
diff --git a/src/sqlitejs.c b/src/sqlitejs.c
index cb4d75d..c56b241 100644
--- a/src/sqlitejs.c
+++ b/src/sqlitejs.c
@@ -11,6 +11,7 @@
 #include <string.h>
 #include <limits.h>
 #include <assert.h>
+#include <math.h>
 #include "sqlitejs.h"
 #include "quickjs.h"
 #include "quickjs-libc.h"
@@ -372,6 +373,18 @@ static void functionjs_free (functionjs_context *fctx) {
 
 // MARK: - Utils -
 
+// A JavaScript number is a double. QuickJS keeps the small whole numbers it can as 32-bit
+// integers, but an INTEGER outside that range, or the result of arithmetic such as 2.5 * 2,
+// is a double too. A whole number that a double holds exactly, from -(2^53 - 1) to 2^53 - 1
+// (Number.isSafeInteger), goes back to SQL as an INTEGER; any other number is a REAL.
+static bool js_number_to_int64 (double num, sqlite3_int64 *out) {
+    const double max_safe_integer = 9007199254740991.0;
+    // NaN fails both comparisons
+    if (!(num >= -max_safe_integer && num <= max_safe_integer) || (num != floor(num))) return false;
+    *out = (sqlite3_int64)num;
+    return true;
+}
+
 // Gets the bytes of an ArrayBuffer, or of the part of an ArrayBuffer that a typed array such
 // as a Uint8Array views: the forms a BLOB takes in JavaScript (a BLOB arrives as an
 // ArrayBuffer). Returns 1 and sets *pbytes and *psize if value is one of them (*pbytes may be
@@ -434,7 +447,9 @@ static int js_bind_value (JSContext *ctx, sqlite3_stmt *vm, int index, JSValueCo
             return sqlite3_bind_int(vm, index, num);
         } else {
             double num;
+            sqlite3_int64 inum;
             JS_ToFloat64(ctx, &num, val);
+            if (js_number_to_int64(num, &inum)) return sqlite3_bind_int64(vm, index, inum);
             return sqlite3_bind_double(vm, index, num);
         }
     }
@@ -660,8 +675,10 @@ static void js_value_to_sqlite (sqlite3_context *context, JSContext *js_ctx, JSV
             sqlite3_result_int(context, num);
         } else {
             double num;
+            sqlite3_int64 inum;
             JS_ToFloat64(js_ctx, &num, value);
-            sqlite3_result_double(context, num);
+            if (js_number_to_int64(num, &inum)) sqlite3_result_int64(context, inum);
+            else sqlite3_result_double(context, num);
         }
         return;
     }
diff --git a/test/main.c b/test/main.c
index b6c6a8a..cb2f899 100644
--- a/test/main.c
+++ b/test/main.c
@@ -748,6 +748,48 @@ abort_test:
     return rc;
 }
 
+// MARK: - Numbers -
+
+int test_numbers (void) {
+    sqlite3 *db = NULL;
+    int rc = test_open(&db);
+    if (rc != SQLITE_OK) goto abort_test;
+
+    rc = db_exec(db, "SELECT js_create_scalar('identity', '(function(args){ return args[0]; })');");
+    if (rc != SQLITE_OK) goto abort_test;
+
+    // integers keep their type and value through JavaScript, beyond the 32-bit range too
+    rc = check_query(db, "WITH v(x) AS (VALUES (0), (42), (-7), (2147483647), (2147483648), (-2147483649), (9007199254740991), (-9007199254740991)) SELECT group_concat(typeof(identity(x)) || ' ' || (identity(x) = x), ',') FROM v;", "integer 1,integer 1,integer 1,integer 1,integer 1,integer 1,integer 1,integer 1");
+    if (rc != SQLITE_OK) goto abort_test;
+
+    // REALs that are not whole numbers stay REAL; a whole number is an INTEGER, as JavaScript cannot tell 3.0 from 3
+    rc = check_query_v2(db, "SELECT quote(identity(3.5)), quote(identity(-0.25)), quote(identity(1e300)), quote(identity(3.0));", (const char*[]){"3.5", "-0.25", "1.0e+300", "3"}, 4);
+    if (rc != SQLITE_OK) goto abort_test;
+
+    // beyond 2^53 - 1 a double cannot hold every integer, so the result is a REAL
+    rc = check_query(db, "SELECT typeof(identity(9007199254740993));", "real");
+    if (rc != SQLITE_OK) goto abort_test;
+
+    // results of arithmetic
+    rc = check_query_v2(db, "SELECT quote(js_eval('2.5 * 2')), quote(js_eval('1e10')), typeof(js_eval('0.1 + 0.2')), typeof(js_eval('NaN'));", (const char*[]){"5", "10000000000", "real", "null"}, 4);
+    if (rc != SQLITE_OK) goto abort_test;
+
+    // an aggregate whose result is past the 32-bit range
+    rc = db_exec(db, "SELECT js_create_aggregate('js_sum', 'total = 0;', '(function(args){ total += args[0]; })', '(function(){ return total; })');");
+    if (rc != SQLITE_OK) goto abort_test;
+    rc = check_query(db, "WITH v(x) AS (VALUES (3000000000), (1)) SELECT typeof(js_sum(x)) || ' ' || js_sum(x) FROM v;", "integer 3000000001");
+    if (rc != SQLITE_OK) goto abort_test;
+
+    // db.exec() binds numbers the same way
+    rc = check_query(db, "SELECT js_eval('(function () { const rs = db.exec(\"SELECT typeof(?), typeof(?), typeof(?)\", 2147483648, 2.5 * 2, 2.5); rs.next(); return [rs.get(0), rs.get(1), rs.get(2)].join(); })()');", "integer,integer,real");
+    if (rc != SQLITE_OK) goto abort_test;
+
+abort_test:
+    if (rc != SQLITE_OK && db) printf("Error: %s\n", sqlite3_errmsg(db));
+    if (db) sqlite3_close(db);
+    return rc;
+}
+
