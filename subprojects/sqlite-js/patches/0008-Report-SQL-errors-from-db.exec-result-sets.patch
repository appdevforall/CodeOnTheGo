 README.md      | 12 ++++++++++++
 src/sqlitejs.c | 19 +++++++++++++++----
 test/main.c    | 35 +++++++++++++++++++++++++++++++++++
 3 files changed, 62 insertions(+), 4 deletions(-)

diff --git a/README.md b/README.md
index 8ef6804..abec56b 100644
--- a/README.md
+++ b/README.md
@@ -397,6 +397,18 @@ SELECT js_eval('Math.PI * Math.pow(5, 2)');
 SELECT js_eval('new Date(1629381600000).toLocaleDateString()');
 ```
 
+### Running SQL from JavaScript
+
+JavaScript can run SQL on the same connection through the global `db` object. `db.exec(sql, ...parameters)` prepares one statement, binds the parameters to its `?` placeholders, and returns a result set. The statement runs as you step through it: `next()` moves to the next row and returns `true`, or `false` after the last; `get(i)` and `name(i)` give a column's value and name; `columnCount` is the number of columns; and `toArray()` returns the remaining rows as arrays. A statement that returns no rows, such as an `INSERT`, also runs only when you call `next()` or `toArray()`.
+
+An error while the statement runs, such as a failed constraint, is thrown from `next()` or `toArray()`, as an error in the SQL itself is thrown from `db.exec()`.
+
+```sql
+CREATE TABLE t(a UNIQUE);
+SELECT js_eval('db.exec("INSERT INTO t VALUES (?)", 1).next()');  -- 0: the row is inserted, and next() is false, as there are no rows
+SELECT js_eval('(function () { try { db.exec("INSERT INTO t VALUES (?)", 1).next(); } catch (e) { return e.message; } })()');  -- UNIQUE constraint failed: t.a
+```
+
 ## Utility Functions
 
 ### js_version
diff --git a/src/sqlitejs.c b/src/sqlitejs.c
index e5562f4..8f6e3a9 100644
--- a/src/sqlitejs.c
+++ b/src/sqlitejs.c
@@ -115,11 +115,16 @@ static JSValue js_rowset_next(JSContext *ctx, JSValueConst this_val, int argc, J
     if (!rs) return JS_ThrowTypeError(ctx, "Not a Rowset object");
     
     if (!rs->vm) return JS_FALSE;
-    if (sqlite3_step(rs->vm) == SQLITE_ROW) return JS_TRUE;
+    int rc = sqlite3_step(rs->vm);
+    if (rc == SQLITE_ROW) return JS_TRUE;
 
+    // an error while the statement runs (a constraint, an overflow, an interrupt) is an
+    // exception, as an error while it is prepared is in js_sqlite_exec; only the end of the
+    // rows is false
+    JSValue result = (rc == SQLITE_DONE) ? JS_FALSE : JS_ThrowInternalError(ctx, "%s", sqlite3_errmsg(sqlite3_db_handle(rs->vm)));
     sqlite3_finalize(rs->vm);
     rs->vm = NULL;
-    return JS_FALSE;
+    return result;
 }
 
 static JSValue js_rowset_get(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv) {
@@ -168,8 +173,9 @@ static JSValue js_rowset_to_array(JSContext *ctx, JSValueConst this_val, int arg
     
     int ncols = rs->ncols;
     int nrows = 0;
+    int rc;
     while (true) {
-        int rc = sqlite3_step(rs->vm);
+        rc = sqlite3_step(rs->vm);
         if (rc != SQLITE_ROW) break;
         
         JSValue row = JS_NewArray(ctx);
@@ -186,7 +192,12 @@ static JSValue js_rowset_to_array(JSContext *ctx, JSValueConst this_val, int arg
         
         JS_SetPropertyUint32(ctx, result, nrows++, row);
     }
-    
+
+    // as in js_rowset_next: an error is an exception, not a shorter array
+    if (rc != SQLITE_DONE) {
+        JS_FreeValue(ctx, result);
+        result = JS_ThrowInternalError(ctx, "%s", sqlite3_errmsg(sqlite3_db_handle(rs->vm)));
+    }
     sqlite3_finalize(rs->vm);
     rs->vm = NULL;
     return result;
diff --git a/test/main.c b/test/main.c
index ff1c0e7..3b562dd 100644
--- a/test/main.c
+++ b/test/main.c
@@ -881,6 +881,40 @@ abort_test:
 
 // MARK: -
 
+// MARK: - Exec errors -
+
+int test_exec_errors (void) {
+    sqlite3 *db = NULL;
+    int rc = test_open(&db);
+    if (rc != SQLITE_OK) goto abort_test;
+
+    rc = db_exec(db, "CREATE TABLE u(a UNIQUE); INSERT INTO u VALUES (1);");
+    if (rc != SQLITE_OK) goto abort_test;
+
+    // an error while the statement runs is an exception, from next() and from toArray()
+    rc = check_error(db, "SELECT js_eval('db.exec(\"INSERT INTO u VALUES (1)\").next()');", "UNIQUE constraint failed");
+    if (rc != SQLITE_OK) goto abort_test;
+    rc = check_error(db, "SELECT js_eval('db.exec(\"SELECT abs(-9223372036854775808)\").next()');", "integer overflow");
+    if (rc != SQLITE_OK) goto abort_test;
+    rc = check_error(db, "SELECT js_eval('db.exec(\"SELECT 1 UNION ALL SELECT abs(-9223372036854775808) UNION ALL SELECT 3\").toArray()');", "integer overflow");
+    if (rc != SQLITE_OK) goto abort_test;
+
+    // JavaScript can catch it
+    rc = check_query(db, "SELECT js_eval('(function () { try { db.exec(\"INSERT INTO u VALUES (1)\").next(); return \"no error\"; } catch (e) { return e.message; } })()');", "UNIQUE constraint failed: u.a");
+    if (rc != SQLITE_OK) goto abort_test;
+
+    // the end of the rows is still false, and a statement that succeeds still runs
+    rc = check_query(db, "SELECT js_eval('[db.exec(\"SELECT 1 WHERE 0\").next(), db.exec(\"INSERT INTO u VALUES (2)\").next(), JSON.stringify(db.exec(\"SELECT a FROM u ORDER BY a\").toArray())].join(\" \")');", "false false [[1],[2]]");
+    if (rc != SQLITE_OK) goto abort_test;
+
+abort_test:
+    if (rc != SQLITE_OK && db) printf("Error: %s\n", sqlite3_errmsg(db));
+    if (db) sqlite3_close(db);
+    return rc;
+}
+
+// MARK: -
+
 int test_report(const char *description, int rc){
     printf("%s%-30s %s\n", VERBOSE ? "********** " : "", description, (rc == SQLITE_OK) ? "OK" : "FAILED");
     return (rc == SQLITE_OK) ? 0 : 1;
@@ -902,6 +936,7 @@ int main (void) {
     result += test_report("Blobs", test_blobs());
     result += test_report("Numbers", test_numbers());
     result += test_report("Aggregate errors", test_aggregate_errors());
+    result += test_report("Exec errors", test_exec_errors());
 
     sqlite3_int64 current = 0;
     sqlite3_int64 highwater = 0;
