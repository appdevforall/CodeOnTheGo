From 81453cbd29634c00632d57337b08b581bee03d16 Mon Sep 17 00:00:00 2001
From: David Schachter <davidschachter@appdevforall.org>
Date: Thu, 12 Nov 2026 15:17:11 -0800
Subject: [PATCH 2/3] Keep the stack check within the stack in two more cases

On the initial thread on Linux, RLIMIT_STACK is now counted from the top
of the stack, as the kernel counts it, rather than from where the first
measurement was taken. Counted from there, a first measurement deep in
the stack put the bound below the real one by that depth: with the
extension loaded 2 MB deep on the main thread, js_set_max_stack_size()
allowed 10 MB of an 8 MB stack, and code that called itself without end
at that size crashed the process.

A call into JavaScript on a thread with less room than
SQLITE_JS_STACK_MIN now keeps the measured room rather than the size
set for the connection, 1 MB by default: on a thread with a 64 KB stack,
code that called itself without end crashed. JavaScript there now fails
with "Maximum call stack size exceeded". The minimum still applies where
a runtime is created, since QuickJS cannot create a context in less.

Stack on other threads now also runs forever() on a 64 KB thread. It
crashes without this change and passes with it, also under ASan and
UBSan, and the suite passes 16 of 16. The first case is checked by a
program that loads the extension deep in the main thread's stack: at 2
and 6 MB deep, the largest size allowed was 10.2 and 14.4 MB of 8 MB
before, and about 7.75 MB after, where forever() stops with an error.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Vh2DAXGyHbMzjSsi2zbrkw
---
 src/sqlitejs.c | 17 ++++++++++++-----
 test/main.c    | 12 ++++++++++++
 2 files changed, 24 insertions(+), 5 deletions(-)

diff --git a/src/sqlitejs.c b/src/sqlitejs.c
index a0cacb0..afde928 100644
--- a/src/sqlitejs.c
+++ b/src/sqlitejs.c
@@ -389,9 +389,10 @@ static void js_mem_reset_peak (globaljs_context *js) {
 #endif
 
 // The least stack worth giving JavaScript. QuickJS cannot even create a context below about
-// 16 KB (measured: 4 KB fails, 16 KB works), and it reads 0 as "no check at all", so a smaller
-// measurement is treated as no measurement and leaves the default alone. Failing to catch
-// runaway recursion is the lesser evil next to an extension that cannot load.
+// 16 KB (measured: 4 KB fails, 16 KB works), and it reads 0 as "no check at all", so where a
+// runtime is created a smaller measurement is treated as no measurement and leaves the default
+// alone. Failing to catch runaway recursion is the lesser evil next to an extension that cannot
+// load. A call into JavaScript on an existing runtime keeps any measurement (see js_enter).
 #ifndef SQLITE_JS_STACK_MIN
 #define SQLITE_JS_STACK_MIN     (32 * 1024)
 #endif
@@ -429,7 +430,10 @@ static bool js_stack_low (uintptr_t sp, uintptr_t *low) {
     if (syscall(SYS_gettid) == (long)getpid()) {
         struct rlimit limit;
         if ((getrlimit(RLIMIT_STACK, &limit) == 0) && (limit.rlim_cur != RLIM_INFINITY)) {
-            uintptr_t grows_to = (sp > (uintptr_t)limit.rlim_cur) ? sp - (uintptr_t)limit.rlim_cur : 0;
+            // counted from the top of the stack, as the kernel counts it: counted from sp, a first
+            // measurement deep in the stack would put the bound below the real one
+            uintptr_t high = (uintptr_t)addr + size;
+            uintptr_t grows_to = (high > (uintptr_t)limit.rlim_cur) ? high - (uintptr_t)limit.rlim_cur : 0;
             if (grows_to < thread_low) thread_low = grows_to;
         }
     }
@@ -478,8 +482,11 @@ static void js_enter (globaljs_context *js) {
     if (js->depth++ > 0) return;
     js->cancel_epoch = js_cancel_epoch_load();
     JS_UpdateStackTop(js->runtime);
+    // A thread with less room than SQLITE_JS_STACK_MIN keeps it too: JavaScript there then fails
+    // with "Maximum call stack size exceeded" rather than running past the end of the stack. A
+    // size of 1 rather than 0, which would turn the check off.
     size_t size = js->stack_size, room = 0;
-    if ((size > 0) && js_stack_room(&room) && (room >= SQLITE_JS_STACK_MIN) && (room < size)) size = room;
+    if ((size > 0) && js_stack_room(&room) && (room < size)) size = (room > 0) ? room : 1;
     JS_SetMaxStackSize(js->runtime, size);
 }
 
diff --git a/test/main.c b/test/main.c
index 20e7764..7969419 100644
--- a/test/main.c
+++ b/test/main.c
@@ -1130,6 +1130,13 @@ static void *stack_thread_run (void *ptr) {
     return NULL;
 }
 
+// Runs forever() on the calling thread, which must stop with an error instead of crashing.
+static void *stack_thread_forever (void *ptr) {
+    stack_thread_args *args = (stack_thread_args *)ptr;
+    args->rc = check_error(args->db, "SELECT forever();", "Maximum call stack size exceeded");
+    return NULL;
+}
+
 static void *stack_thread_open (void *ptr) {
     stack_thread_args *args = (stack_thread_args *)ptr;
     args->rc = test_open(&args->db);
@@ -1203,6 +1210,11 @@ int test_stack_threads (void) {
     rc = args.rc;
     if (rc != SQLITE_OK) goto abort_test;
 
+    // and on a thread with less stack left than SQLITE_JS_STACK_MIN: the size is still lowered to
+    // fit, since the default would let code that calls itself without end run past the stack
+    rc = stack_thread(stack_thread_forever, &args, 64 * 1024);
+    if (rc != SQLITE_OK) goto abort_test;
+
     // a thread whose whole stack is under twice the margin still gets a usable runtime
     rc = stack_thread(stack_thread_tiny, &args, 256 * 1024);
 
