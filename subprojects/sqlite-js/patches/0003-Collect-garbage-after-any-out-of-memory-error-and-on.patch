From 2260b1174c223b8ecc7c4619a3573de0cce5441f Mon Sep 17 00:00:00 2001
From: David Schachter <davidschachter@appdevforall.org>
Date: Thu, 12 Nov 2026 15:32:30 -0800
Subject: [PATCH 3/3] Collect garbage after any out-of-memory error and on any
 new limit

Garbage could leave a connection unable to make an allocation that fits
in its memory limit, on every try:

- After an allocation too large to fit fails. QuickJS refuses it before
  making it, so the memory in use never came within 64 KB of the limit
  and the collection after the error did not run. With 40 MB of cyclic
  garbage under the 64 MB default, new ArrayBuffer(30 MB) failed with
  "out of memory" every time. The collection now also runs whenever the
  error is "out of memory": the next try succeeds.
- After a lower limit set above the memory in use. Only a limit within
  64 KB of the memory in use collected. With the garbage of 200,000
  cyclic objects and the limit lowered to 32 MB, new ArrayBuffer(16 MB)
  failed. Setting a limit now always collects.

The Memory limit test covers both, each on a connection of its own; each
case fails without its change. The suite passes 16 of 16, also under
ASan and UBSan.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Vh2DAXGyHbMzjSsi2zbrkw
---
 src/sqlitejs.c | 18 +++++++++++-------
 test/main.c    | 32 ++++++++++++++++++++++++++++++++
 2 files changed, 43 insertions(+), 7 deletions(-)

diff --git a/src/sqlitejs.c b/src/sqlitejs.c
index afde928..6c1183b 100644
--- a/src/sqlitejs.c
+++ b/src/sqlitejs.c
@@ -968,7 +968,9 @@ static void js_error_to_sqlite (sqlite3_context *context, JSContext *js_ctx, JSV
             default_error = "out of memory";
         }
     }
-    bool out_of_memory = js_reached_memory_limit(JS_GetContextOpaque(js_ctx));
+    // An allocation too large to fit is refused before it is counted, so the memory in use need
+    // not have come near the limit: the error itself says so.
+    bool out_of_memory = js_reached_memory_limit(JS_GetContextOpaque(js_ctx)) || (err_msg && (strcmp(err_msg, "out of memory") == 0));
     js_mem_reset_peak(JS_GetContextOpaque(js_ctx));
 
     // set a default error message and code
@@ -980,9 +982,9 @@ static void js_error_to_sqlite (sqlite3_context *context, JSContext *js_ctx, JSV
     if (!JS_IsNull(exception)) JS_FreeValue(js_ctx, exception);
 
     // QuickJS refuses every allocation once the memory in use is over the limit, and it collects
-    // only when it creates an object, which it cannot do without allocating: the connection
-    // would stay out of memory for good. No JavaScript is running here, so collect now, while
-    // the garbage that filled the limit is still reachable from nothing.
+    // only when it creates an object past its threshold, which the code that failed may never
+    // do: the connection would stay out of memory for good. No JavaScript is running here, so
+    // collect now, while the garbage that filled the limit is still reachable from nothing.
     if (out_of_memory) js_collect_below_limit(JS_GetContextOpaque(js_ctx));
 }
 
@@ -1804,9 +1806,11 @@ void js_set_memory_limit (sqlite3_context *context, int argc, sqlite3_value **ar
     js->memory_limit = (limit > SIZE_MAX) ? 0 : (size_t)limit;
     JS_SetMemoryLimit(js->runtime, js->memory_limit);
     js->gc_threshold = 0;   // check the GC threshold against the new limit
-    // a limit at or under the memory in use leaves nothing to allocate from, and QuickJS cannot
-    // collect without allocating, so collect here instead
-    if ((js->memory_limit > 0) && (js->mem_used + 64 * 1024 >= js->memory_limit)) js_collect_below_limit(js);
+    // Garbage left from before counts against the new limit, and QuickJS collects only when it
+    // creates an object past its threshold: a limit at or under the memory in use leaves nothing
+    // to allocate from, and one above it can leave too little for a large allocation. So collect
+    // here, as no JavaScript is running.
+    if (js->memory_limit > 0) js_collect_below_limit(js);
     else js_keep_gc_below_limit(js);
     js_mem_reset_peak(js);
 }
diff --git a/test/main.c b/test/main.c
index 7969419..dfb0079 100644
--- a/test/main.c
+++ b/test/main.c
@@ -900,6 +900,38 @@ int test_memory_limit (void) {
     rc = check_query(db, "SELECT js_eval('[1, 2, 3].map(x => x * 2).join()');", "2,4,6");
     if (rc != SQLITE_OK) goto abort_test;
 
+    // and so does a lower limit set above it: the garbage would fill the room left under the new
+    // limit, and an allocation that needs that room would fail
+    if (db) sqlite3_close(db);
+    db = NULL;
+    rc = test_open(&db);
+    if (rc != SQLITE_OK) goto abort_test;
+    rc = db_exec(db, "SELECT js_set_memory_limit(0);");
+    if (rc != SQLITE_OK) goto abort_test;
+    rc = check_query(db, "SELECT js_eval('globalThis.g = []; for (let i = 0; i < 200000; i++) { const o = {}; o.o = o; g.push(o); } g.length');", "200000");
+    if (rc != SQLITE_OK) goto abort_test;
+    rc = db_exec(db, "SELECT js_eval('delete globalThis.g; 0');");
+    if (rc != SQLITE_OK) goto abort_test;
+    rc = db_exec(db, "SELECT js_set_memory_limit(32 * 1024 * 1024);");
+    if (rc != SQLITE_OK) goto abort_test;
+    rc = check_query(db, "SELECT js_eval('new ArrayBuffer(16 * 1024 * 1024).byteLength');", "16777216");
+    if (rc != SQLITE_OK) goto abort_test;
+
+    // garbage that leaves no room for a large allocation is collected after it fails, so the next
+    // try succeeds: QuickJS refuses an allocation that would pass the limit before making it, so
+    // the memory in use never comes near the limit, and nothing else would collect the garbage
+    if (db) sqlite3_close(db);
+    db = NULL;
+    rc = test_open(&db);
+    if (rc != SQLITE_OK) goto abort_test;
+    rc = check_query(db, "SELECT js_eval('globalThis.g = []; for (let i = 0; i < 40; i++) { const o = { b: new ArrayBuffer(1024 * 1024) }; o.o = o; g.push(o); } g.length');", "40");
+    if (rc != SQLITE_OK) goto abort_test;
+    rc = db_exec(db, "SELECT js_eval('delete globalThis.g; 0');");
+    if (rc != SQLITE_OK) goto abort_test;
+    sqlite3_exec(db, "SELECT js_eval('new ArrayBuffer(30 * 1024 * 1024).byteLength');", NULL, NULL, NULL);   // may fail
+    rc = check_query(db, "SELECT js_eval('new ArrayBuffer(30 * 1024 * 1024).byteLength');", "31457280");
+    if (rc != SQLITE_OK) goto abort_test;
+
     // running out of memory through many small allocations, which leaves no room for the error
     // object, is reported as "out of memory" too
     rc = check_error(db, "SELECT js_eval('(function () { let h = null; for (;;) h = {n: h}; })()');", "out of memory");
-- 
