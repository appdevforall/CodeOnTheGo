From e4b4a5ec87400df1a8c3087f391316977b84b6b0 Mon Sep 17 00:00:00 2001
From: David Schachter <davidschachter@appdevforall.org>
Date: Tue, 10 Nov 2026 20:59:46 -0800
Subject: [PATCH 03/10] Keep the functions that run code out of the schema

js_eval(), js_create_*(), js_load_text(), js_load_blob(), js_init_table()
and the js_set_* functions were registered without SQLITE_DIRECTONLY, so
a view, trigger, CHECK constraint or generated column could call them.
With PRAGMA trusted_schema ON, the default of the SQLite library (the
sqlite3 shell turns it off), a database from an untrusted source could
run JavaScript or read files just by being queried:
`CREATE VIEW v AS SELECT js_eval('...')`.

Register every function but js_version() with SQLITE_DIRECTONLY, so only
top-level SQL can call them. TEMP views and triggers still can: SQLite
trusts them, since only the connection itself can make them, and the
README says so. The functions created with js_create_* are
unchanged, so they still work in views, triggers and indexes. The flag
is computed from the function's name rather than from a table that
parallels the function list, so a function added later gets it without
a matching edit.

Add a Direct only test: every function but js_version() has the flag in
function_list; with trusted_schema ON, a view, a trigger and a
generated column cannot call js_eval() or js_load_text(), a top-level
statement can, and a view can still use js_version() and a function made
with js_create_scalar().

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Vh2DAXGyHbMzjSsi2zbrkw
---
 README.md      |  6 ++++++
 src/sqlitejs.c |  9 +++++++--
 test/main.c    | 53 ++++++++++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 66 insertions(+), 2 deletions(-)

diff --git a/README.md b/README.md
index d88b539..bcbb7f0 100644
--- a/README.md
+++ b/README.md
@@ -419,6 +419,12 @@ SELECT js_set_memory_limit(268435456);  -- Allow 256 MB
 SELECT js_set_memory_limit(0);          -- No limit
 ```
 
+### Using the functions from the schema
+
+Every function above but `js_version` runs JavaScript, reads files or changes the JavaScript runtime, so it is registered with `SQLITE_DIRECTONLY`: only top-level SQL can call it, never a view, trigger, CHECK constraint, generated column or index stored in the database. (TEMP views and triggers can call it: SQLite trusts them, since only the connection itself can make them.) That way a database from an untrusted source cannot run JavaScript just by being queried. The functions you create with `js_create_scalar`, `js_create_aggregate`, `js_create_window` and `js_create_collation` are not restricted.
+
+A database can still store JavaScript in its `js_functions` table, and `js_init_table(1)` runs it. Call it only on databases you trust.
+
 ### Interrupting JavaScript
 
 JavaScript runs inside the SQL statement that calls it, so `sqlite3_interrupt()` stops it as it stops any statement: the statement fails with an "interrupted" error, even if the code catches exceptions. In the `sqlite3` shell, Ctrl-C does this. Interrupting JavaScript needs SQLite 3.41.0 or later.
diff --git a/src/sqlitejs.c b/src/sqlitejs.c
index 1ba634e..8a48d92 100644
--- a/src/sqlitejs.c
+++ b/src/sqlitejs.c
@@ -1471,11 +1471,16 @@ APIEXPORT int sqlite3_js_init (sqlite3 *db, char **pzErrMsg, const sqlite3_api_r
     const char *f_name[] = {"js_version", "js_version", "js_create_scalar", "js_create_aggregate", "js_create_window", "js_create_collation", "js_eval", "js_load_text", "js_load_blob", "js_init_table", "js_init_table", "js_set_max_stack_size", "js_set_memory_limit"};
     const void *f_ptr[] = {js_version0, js_version1, js_create_scalar, js_create_aggregate, js_create_window, js_create_collation, js_eval, js_load_text, js_load_blob, js_init_table0, js_init_table1, js_set_max_stack_size, js_set_memory_limit};
     int f_arg[] = {0, 1, 2, 4, 6, 2, 1, 1, 1, 0, 1, 1, 1};
-    
+
     size_t f_count = sizeof(f_name) / sizeof(const char *);
     for (size_t i=0; i<f_count; ++i) {
         js->ref_count++;
-        int rc = sqlite3_create_function_v2(db, f_name[i], f_arg[i], SQLITE_UTF8, (void *)js, f_ptr[i], NULL, NULL, globaljs_dec_and_free_if_needed);
+        // Every function but js_version runs JavaScript, reads files or changes the JavaScript
+        // runtime. SQLITE_DIRECTONLY keeps them out of the schema (views, triggers, CHECK
+        // constraints, generated columns, indexes), so that a database from an untrusted source
+        // cannot run JavaScript just by being queried, whatever PRAGMA trusted_schema says.
+        int flags = (strcmp(f_name[i], "js_version") == 0) ? 0 : SQLITE_DIRECTONLY;
+        int rc = sqlite3_create_function_v2(db, f_name[i], f_arg[i], SQLITE_UTF8 | flags, (void *)js, f_ptr[i], NULL, NULL, globaljs_dec_and_free_if_needed);
         if (rc != SQLITE_OK) {
             if (pzErrMsg) *pzErrMsg = sqlite3_mprintf("Error creating function %s: %s", f_name[i], sqlite3_errmsg(db));
             // sqlite3_create_function_v2 always invokes the xDestroy callback when it fails,
diff --git a/test/main.c b/test/main.c
index 4adeb82..c13e043 100644
--- a/test/main.c
+++ b/test/main.c
@@ -668,6 +668,58 @@ abort_test:
     return rc;
 }
 
+// MARK: - Direct only -
+
+int test_direct_only (void) {
+    sqlite3 *db = NULL;
+    int rc = test_open(&db);
+    if (rc != SQLITE_OK) goto abort_test;
+
+    // every function but js_version is SQLITE_DIRECTONLY (0x80000 in the flags of function_list)
+    rc = check_query_v2(db, "SELECT count(*) > 10, sum(((flags & 0x80000) != 0) != (name <> 'js_version')) FROM pragma_function_list WHERE name LIKE 'js\\_%' ESCAPE '\\';", (const char*[]){"1", "0"}, 2);
+    if (rc != SQLITE_OK) goto abort_test;
+
+    // trusted_schema ON lets the schema use any function that is not SQLITE_DIRECTONLY
+    rc = db_exec(db, "PRAGMA trusted_schema = ON; CREATE TABLE t (a); CREATE TABLE log (msg);");
+    if (rc != SQLITE_OK) goto abort_test;
+
+    // a view, a trigger and a generated column cannot run JavaScript or read files
+    // (SQLite reports these either when the schema is created or when it is used)
+    sqlite3_exec(db, "CREATE VIEW v_eval AS SELECT js_eval('6 * 7') AS x;", NULL, NULL, NULL);
+    rc = check_error(db, "SELECT x FROM v_eval;", "unsafe use of js_eval()");
+    if (rc != SQLITE_OK) goto abort_test;
+    sqlite3_exec(db, "CREATE VIEW v_load AS SELECT js_load_text('/etc/hosts') AS x;", NULL, NULL, NULL);
+    rc = check_error(db, "SELECT x FROM v_load;", "unsafe use of js_load_text()");
+    if (rc != SQLITE_OK) goto abort_test;
+    sqlite3_exec(db, "CREATE TRIGGER t_insert AFTER INSERT ON t BEGIN INSERT INTO log VALUES (js_eval('\"trigger ran\"')); END;", NULL, NULL, NULL);
+    rc = check_error(db, "INSERT INTO t VALUES (1);", "unsafe use of js_eval()");
+    if (rc != SQLITE_OK) goto abort_test;
+    rc = check_query(db, "SELECT count(*) FROM log;", "0");
+    if (rc != SQLITE_OK) goto abort_test;
+    sqlite3_exec(db, "DROP TRIGGER IF EXISTS t_insert;", NULL, NULL, NULL);
+    if (sqlite3_exec(db, "CREATE TABLE g (a, b AS (js_eval('1')));", NULL, NULL, NULL) == SQLITE_OK) {
+        rc = check_error(db, "INSERT INTO g (a) VALUES (1);", "unsafe use of js_eval()");
+        if (rc != SQLITE_OK) goto abort_test;
+    }
+
+    // a top-level statement can still use them
+    rc = check_query(db, "SELECT js_eval('6 * 7');", "42");
+    if (rc != SQLITE_OK) goto abort_test;
+
+    // and the schema can still use js_version() and the functions created with js_create_*
+    rc = db_exec(db, "SELECT js_create_scalar('twice', '(function(args){ return args[0] * 2; })');");
+    if (rc != SQLITE_OK) goto abort_test;
+    rc = db_exec(db, "CREATE VIEW v_ok AS SELECT js_version() IS NOT NULL AS has_version, twice(21) AS answer;");
+    if (rc != SQLITE_OK) goto abort_test;
+    rc = check_query_v2(db, "SELECT has_version, answer FROM v_ok;", (const char*[]){"1", "42"}, 2);
+    if (rc != SQLITE_OK) goto abort_test;
+
+abort_test:
+    if (rc != SQLITE_OK && db) printf("Error: %s\n", sqlite3_errmsg(db));
+    if (db) sqlite3_close(db);
+    return rc;
+}
+
 // MARK: -
 
 int test_report(const char *description, int rc){
@@ -686,6 +738,7 @@ int main (void) {
     result += test_report("Thread", test_thread());
     result += test_report("Interrupt", test_interrupt());
     result += test_report("Memory limit", test_memory_limit());
+    result += test_report("Direct only", test_direct_only());
 
     sqlite3_int64 current = 0;
     sqlite3_int64 highwater = 0;
