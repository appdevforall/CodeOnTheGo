From d703446ff1a37ef0c623d20bf363e51590a0fae7 Mon Sep 17 00:00:00 2001
From: David Schachter <davidschachter@appdevforall.org>
Date: Thu, 12 Nov 2026 00:05:58 -0800
Subject: [PATCH] Let the host cancel all running JavaScript

sqlitejs_cancel_all() stops the JavaScript running in every connection:
each call fails with an "interrupted" error, even code that catches
every exception. JavaScript that begins afterwards runs normally.

Android cannot otherwise stop a runaway function: it cancels a query
with a progress handler, which SQLite never calls while a function runs,
and Room 2.7 and later pass no cancellation signal at all. A global
epoch, read when the outermost call into JavaScript begins and compared
by the existing interrupt handler, makes the cancel reach every runtime
without a list of connections. The interrupt handler is now installed
even when sqlite3_is_interrupted() is unavailable (SQLite before 3.41),
so cancelling still works there.

When the cancel stops a call, the handler also interrupts that call's
connection with sqlite3_interrupt(), so its statement stops too. A
collation cannot report an error: without this, a sort went on calling
it, each call beginning after the cancel, and never ended. Add to the
Cancel all test a runaway collation that one cancel stops; it hung
without this.

The test's worker cancels only once the JavaScript under test has called
started(), an SQL function, since a cancel that came first would leave
the JavaScript running. If that has not happened within 10 seconds, the
worker fails the test with a message instead of cancelling. Like the
Interrupt test, a watchdog ends the program if the JavaScript cannot be
stopped.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Vh2DAXGyHbMzjSsi2zbrkw
---
 src/sqlitejs.c | 42 +++++++++++++++++++++++++--
 src/sqlitejs.h |  1 +
 test/main.c    | 79 ++++++++++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 119 insertions(+), 3 deletions(-)

diff --git a/src/sqlitejs.c b/src/sqlitejs.c
index 9137ca8..339fee1 100644
--- a/src/sqlitejs.c
+++ b/src/sqlitejs.c
@@ -70,6 +70,8 @@ typedef struct {
     size_t              mem_peak;       // the most in use since the last result or error
     size_t              stack_size;     // in bytes, 0 for no check: see js_set_max_stack_size()
     int                 depth;          // calls into JavaScript in progress: see js_enter()
+    unsigned            cancel_epoch;   // js_cancel_epoch when the outermost call began
+    bool                check_interrupted;  // sqlite3_is_interrupted() is available
 } globaljs_context;
 
 typedef struct {
@@ -264,6 +266,30 @@ static void js_collect_below_limit (globaljs_context *js) {
     js_keep_gc_below_limit(js);
 }
 
+// Bumped by sqlitejs_cancel_all(): JavaScript that began before stops, as if interrupted.
+static unsigned js_cancel_epoch;
+
+static unsigned js_cancel_epoch_load (void) {
+#if defined(__clang__) || defined(__GNUC__)
+    return __atomic_load_n(&js_cancel_epoch, __ATOMIC_ACQUIRE);
+#else
+    return *(volatile unsigned *)&js_cancel_epoch;
+#endif
+}
+
+// Stops all JavaScript that is running now, in every connection: each call fails with an
+// "interrupted" error, and the statement that called it is interrupted. JavaScript that begins
+// afterwards runs normally. Safe from any thread.
+// For hosts whose own cancelling cannot reach JavaScript: Android cancels a query with a
+// progress handler, which SQLite never calls while a JavaScript function runs.
+void sqlitejs_cancel_all (void) {
+#if defined(__clang__) || defined(__GNUC__)
+    __atomic_add_fetch(&js_cancel_epoch, 1, __ATOMIC_RELEASE);
+#else
+    (*(volatile unsigned *)&js_cancel_epoch)++;
+#endif
+}
+
 // QuickJS calls this from time to time while it runs code. A non-zero result stops the code
 // with an uncatchable "interrupted" error, so sqlite3_interrupt() (Ctrl-C in the sqlite3 shell,
 // a cancelled query in an app) also stops JavaScript that never returns to SQLite.
@@ -271,7 +297,13 @@ static int js_interrupt_handler (JSRuntime *rt, void *opaque) {
     UNUSED(rt);
     globaljs_context *js = (globaljs_context *)opaque;
     js_keep_gc_below_limit(js);
-    return (js->db != NULL) && sqlite3_is_interrupted(js->db);
+    if (js->cancel_epoch != js_cancel_epoch_load()) {
+        // The statement is interrupted too: a collation cannot report an error, so the
+        // statement would go on calling JavaScript, each call beginning after the cancel.
+        if (js->db) sqlite3_interrupt(js->db);
+        return 1;
+    }
+    return js->check_interrupted && (js->db != NULL) && sqlite3_is_interrupted(js->db);
 }
 
 // The most memory, in bytes, the JavaScript runtime of a connection may allocate until
@@ -442,6 +474,7 @@ static bool js_stack_room (size_t *room) {
 // runs JavaScript) is on the same thread and keeps the outer call's limit.
 static void js_enter (globaljs_context *js) {
     if (js->depth++ > 0) return;
+    js->cancel_epoch = js_cancel_epoch_load();
     JS_UpdateStackTop(js->runtime);
     size_t size = js->stack_size, room = 0;
     if ((size > 0) && js_stack_room(&room) && (room >= SQLITE_JS_STACK_MIN) && (room < size)) size = room;
@@ -461,6 +494,8 @@ static globaljs_context *globaljs_init (sqlite3 *db) {
     memset(js, 0, sizeof(globaljs_context));
     js->typed_array_byte_offset = JS_UNDEFINED;
     js->typed_array_byte_length = JS_UNDEFINED;
+    // JavaScript that runs while the connection is set up must not count as begun before a cancel
+    js->cancel_epoch = js_cancel_epoch_load();
     
     rt = JS_NewRuntime2(&js_mem_funcs, js);
     if (!rt) goto abort_init;
@@ -469,8 +504,9 @@ static globaljs_context *globaljs_init (sqlite3 *db) {
     //JS_SetMaxStackSize(rt, 10 * 1024);
     
     // sqlite3_is_interrupted() is new in SQLite 3.41.0: an older library has no such entry
-    // in its sqlite3_api_routines, so JavaScript cannot be interrupted there
-    if (sqlite3_libversion_number() >= 3041000) JS_SetInterruptHandler(rt, js_interrupt_handler, js);
+    // in its sqlite3_api_routines, so JavaScript cannot be interrupted there, only cancelled
+    js->check_interrupted = (sqlite3_libversion_number() >= 3041000);
+    JS_SetInterruptHandler(rt, js_interrupt_handler, js);
     
     // the default stack size must fit in the stack of the thread that loads the extension: Windows
     // gives a main thread 1 MB, and apps often give their threads no more
diff --git a/src/sqlitejs.h b/src/sqlitejs.h
index 80fe49d..fea0870 100644
--- a/src/sqlitejs.h
+++ b/src/sqlitejs.h
@@ -21,5 +21,6 @@
 int sqlite3_js_init (sqlite3 *db, char **pzErrMsg, const sqlite3_api_routines *pApi);
 const char *sqlitejs_version (void);
 const char *quickjs_version (void);
+void sqlitejs_cancel_all (void);
 
 #endif
diff --git a/test/main.c b/test/main.c
index 0c8a47b..389fc1f 100644
--- a/test/main.c
+++ b/test/main.c
@@ -932,6 +932,84 @@ abort_test:
     return rc;
 }
 
+// MARK: - Cancel all -
+
+// Set by started(), an SQL function that the JavaScript under test calls before it spins, so
+// that the worker cancels only JavaScript that is running: a cancel that came first would not
+// stop it
+static int test_js_started;
+
+static void test_started (sqlite3_context *context, int argc, sqlite3_value **argv) {
+    (void)argc; (void)argv;
+    __atomic_store_n(&test_js_started, 1, __ATOMIC_RELEASE);
+    sqlite3_result_null(context);
+}
+
+static void *test_cancel_all_worker (void *ptr) {
+    (void)ptr;
+    // wait for the JavaScript to start, for at most 10 s; cancelling before it starts would
+    // leave it running, so a JavaScript that has not started by then fails the test here
+    for (int i = 0; i < 1000 && !__atomic_load_n(&test_js_started, __ATOMIC_ACQUIRE); ++i) usleep(10 * 1000);
+    if (!__atomic_load_n(&test_js_started, __ATOMIC_ACQUIRE)) {
+        printf("FAIL: the JavaScript under test did not start in 10 seconds\n");
+        fflush(stdout);
+        abort();
+    }
+    sqlitejs_cancel_all();
+    return NULL;
+}
+
+// sqlitejs_cancel_all() stops the JavaScript running in every connection, as Android's own
+// cancelling (a progress handler, which SQLite never calls while a function runs) cannot.
+int test_cancel_all (void) {
+    sqlite3 *db = NULL, *db2 = NULL;
+    pthread_t thread;
+
+    int seconds = 30;
+    pthread_t watchdog;
+    test_watchdog_stop = 0;
+    bool watching = (pthread_create(&watchdog, NULL, test_watchdog, &seconds) == 0);
+
+    int rc = test_open(&db);
+    if (rc != SQLITE_OK) goto abort_test;
+    rc = sqlite3_create_function(db, "started", 0, SQLITE_UTF8, NULL, test_started, NULL, NULL);
+    if (rc != SQLITE_OK) goto abort_test;
+    rc = db_exec(db, "SELECT js_create_scalar('spin', '(function (args) { db.exec(\"SELECT started()\").next(); for (;;) { try { while (true) {} } catch (e) {} } })');");
+    if (rc != SQLITE_OK) goto abort_test;
+
+    // JavaScript running now stops, even code that catches every exception
+    test_js_started = 0;
+    if (pthread_create(&thread, NULL, test_cancel_all_worker, NULL) != 0) { rc = SQLITE_ERROR; goto abort_test; }
+    rc = check_error(db, "SELECT spin();", "interrupted");
+    pthread_join(thread, NULL);
+    if (rc != SQLITE_OK) goto abort_test;
+
+    // a collation cannot report an error, so its statement is interrupted too: otherwise the sort
+    // would go on calling it, and each call, begun after the cancel, would run
+    rc = db_exec(db, "SELECT js_create_collation('spin_collation', '(function (a, b) { db.exec(\"SELECT started()\").next(); for (;;) {} })');");
+    if (rc != SQLITE_OK) goto abort_test;
+    test_js_started = 0;
+    if (pthread_create(&thread, NULL, test_cancel_all_worker, NULL) != 0) { rc = SQLITE_ERROR; goto abort_test; }
+    rc = check_error(db, "SELECT column1 FROM (VALUES ('a'), ('b'), ('c')) ORDER BY column1 COLLATE spin_collation;", "interrupted");
+    pthread_join(thread, NULL);
+    if (rc != SQLITE_OK) goto abort_test;
+
+    // JavaScript that begins afterwards runs normally, on this connection and on a new one
+    rc = check_query(db, "SELECT js_eval('1 + 1');", "2");
+    if (rc != SQLITE_OK) goto abort_test;
+    rc = test_open(&db2);
+    if (rc != SQLITE_OK) goto abort_test;
+    rc = check_query(db2, "SELECT js_eval('2 + 2');", "4");
+
+abort_test:
+    test_watchdog_stop = 1;
+    if (watching) pthread_join(watchdog, NULL);
+    if (rc != SQLITE_OK && db) printf("Error: %s\n", sqlite3_errmsg(db));
+    if (db) sqlite3_close(db);
+    if (db2) sqlite3_close(db2);
+    return rc;
+}
+
 // MARK: - Stack size -
 
 int test_stack_size (void) {
@@ -1114,6 +1192,7 @@ int main (void) {
     result += test_report("Serialization 3", test_serialization(DB_PATH, true,  3)); // load the new implementations
     result += test_report("Thread", test_thread());
     result += test_report("Interrupt", test_interrupt());
+    result += test_report("Cancel all", test_cancel_all());
     result += test_report("Direct only", test_direct_only());
     result += test_report("Aggregate errors", test_aggregate_errors());
     result += test_report("Exec errors", test_exec_errors());
-- 
2.53.0

