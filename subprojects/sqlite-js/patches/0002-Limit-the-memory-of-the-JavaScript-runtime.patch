+        js_global_init(ctx, js);
+    }
+    JS_SetMemoryLimit(js->runtime, js->memory_limit);
+    js_mem_reset_peak(js);
     if (!ctx) {
         sqlite3_result_error(context, "Unable to create a JS context.", -1);
         return false;
     }
-    
